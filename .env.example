# Host path to your WoW SavedVariables directory (mount target is /wow/SavedVariables)
# Example (Wine/Lutris-ish): use quotes (spaces) instead of backslash escaping.
# WOW_SAVEDVARS_DIR_HOST="/home/srcfvz/Games/World of Warcraft/drive_c/Program Files (x86)/World of Warcraft/_retail_/WTF/Account/<ACCOUNT>/SavedVariables"
WOW_SAVEDVARS_DIR_HOST=

# Optional: mount the game root (used by wow_addons_list + wow_paths_probe)
# WOW_SCAN_ROOT_HOST="/home/srcfvz/Games/World of Warcraft/drive_c/Program Files (x86)/World of Warcraft/_retail_"
WOW_SCAN_ROOT_HOST=
