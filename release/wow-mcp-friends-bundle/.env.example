# Host path to your WoW SavedVariables directory (mount target is /wow/SavedVariables)
# Example (Linux Wine/Lutris): use quotes (spaces) instead of backslash escaping.
# WOW_SAVEDVARS_DIR_HOST="/home/<user>/Games/World of Warcraft/drive_c/Program Files (x86)/World of Warcraft/_classic_/WTF/Account/<ACCOUNT>/SavedVariables"
#
# Example (Windows): (note: use .env only if your tool reads it; PowerShell can also set env vars)
# WOW_SAVEDVARS_DIR_HOST="C:\\Program Files (x86)\\World of Warcraft\\_classic_\\WTF\\Account\\<ACCOUNT>\\SavedVariables"
WOW_SAVEDVARS_DIR_HOST=

# Optional: mount the game root (used by wow_addons_list + wow_paths_probe)
# WOW_SCAN_ROOT_HOST="/home/<user>/Games/World of Warcraft/drive_c/Program Files (x86)/World of Warcraft/_classic_"
# WOW_SCAN_ROOT_HOST="C:\\Program Files (x86)\\World of Warcraft\\_classic_"
WOW_SCAN_ROOT_HOST=
